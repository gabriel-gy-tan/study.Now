# Copy to .env for local development. Never commit the real .env.

# Which config class app.py loads: development | testing | production
APP_ENV=development

# Flask session signing key. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL connection string.
# Local:    postgresql+psycopg://user:pass@localhost:5432/studynow
# Neon dev: use the POOLED (-pooler) connection string from the dev branch
DATABASE_URL=

# Connection string for the TEST database (Neon test branch).
# Tests run migrations and TRUNCATE, so never point this at dev or prod.
TEST_DATABASE_URL=

# Flask-Limiter storage. In-memory is fine for a single Render instance.
# Move to Redis before running more than one instance.
RATELIMIT_STORAGE_URI=memory://
